
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#2F126E"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Panel informasi pemain, skor, dan percobaan -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_header_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="VAULT PLAYER"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvScore"
                android:layout_width="74dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:translationY="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="SKOR&#10;100"
                android:textColor="#FFD95A"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvAttempts"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:translationY="4dp"
                android:fontFamily="sans-serif-medium"
                android:text="PERCOBAAN&#10;0"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Logo brankas -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="46dp"
            android:gravity="center"
            android:text="🔐"
            android:textSize="68sp" />

        <!-- Judul permainan -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="Guess The Vault"
            android:textColor="#FFFFFF"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Slogan permainan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Tebak  •  Temukan  •  Buka"
            android:textColor="#D8C8F4"
            android:textSize="15sp" />

        <!-- Pesan permainan -->
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:background="#481387"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:minHeight="62dp"
            android:padding="14dp"
            android:text="Masukkan tebakan pertama Anda"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <!-- Kolom input angka -->
        <EditText
            android:id="@+id/etGuess"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:background="#FFFFFF"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:hint="Masukkan angka 0–100"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLength="3"
            android:padding="14dp"
            android:textColor="#2C1A47"
            android:textColorHint="#877A9A"
            android:textSize="18sp" />

        <!-- Tombol membuka brankas -->
        <Button
            android:id="@+id/btnGuess"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#ED2F9A"
            android:fontFamily="sans-serif-medium"
            android:text="Buka Brankas"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp" />

        <!-- Tombol mengulang permainan -->
        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#2489E8"
            android:fontFamily="sans-serif-medium"
            android:text="Main Lagi"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:visibility="gone" />

        <!-- Keterangan permainan -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif"
            android:gravity="center"
            android:text="Setiap tebakan salah mengurangi skor sebesar 5 poin."
            android:textColor="#C9B8E5"
            android:textSize="13sp" />

    </LinearLayout>

</ScrollView>
